{#
  Each item is either a link render array ("link"), which keeps the
  attributes core gives it (the modal dialogs, the AJAX links, the accessible
  names), a plain title and url, or a text without a link.
#}
{% set first = links|first %}
{% set rest = links|slice(1) %}
{% if first %}
  <div class="uk-inline uikit-admin-operations">
    {% if first.link %}
      {{ first.link|add_class(['uk-button', 'uk-button-default', 'uk-button-small']) }}
    {% elseif first.url %}
      <a href="{{ first.url }}" class="uk-button uk-button-default uk-button-small">{{ first.title }}</a>
    {% else %}
      <span class="uk-button uk-button-default uk-button-small uk-disabled">{{ first.text ?? first.title }}</span>
    {% endif %}
    {% if rest %}
      <button class="uk-button uk-button-default uk-button-small" type="button" aria-label="{{ 'More operations'|t }}" aria-haspopup="true">
        <span uk-icon="icon: more" aria-hidden="true"></span>
      </button>
      <div uk-dropdown="mode: click; pos: bottom-right">
        <ul class="uk-nav uk-dropdown-nav">
          {% for item in rest %}
            {% if item.link %}
              <li>{{ item.link }}</li>
            {% elseif item.url %}
              <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {% else %}
              <li class="uk-disabled"><span>{{ item.text ?? item.title }}</span></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
{% endif %}
