{#
/**
 * @file
 * The sign-in screens: a brand panel and the form in a card.
 */
#}
{% set layout = layout|default('center') %}
{% set initial = site_name|default('D')|first|upper %}
<div class="uikit-admin-sign-in uikit-admin-sign-in--{{ layout }}">
  <div class="uikit-admin-sign-in__brand">
    <div class="uikit-admin-sign-in__brand-inner">
      <a class="uikit-admin-sign-in__site" href="{{ path('<front>') }}">
        {% if logo %}
          <img class="uikit-admin-sign-in__logo" src="{{ logo }}" alt="" />
        {% else %}
          <span class="uikit-admin-sign-in__mark" aria-hidden="true">{{ initial }}</span>
        {% endif %}
        <span class="uikit-admin-sign-in__name">{{ site_name|default('Drupal') }}</span>
      </a>
      {% if message %}
        <p class="uikit-admin-sign-in__message">{{ message }}</p>
      {% endif %}
    </div>
  </div>
  <main id="main-content" class="uikit-admin-sign-in__main" tabindex="-1">
    <div class="uikit-admin-sign-in__card">
      <div class="uikit-admin-sign-in__title">{{ title }}</div>
      {{ messages }}
      <div class="uikit-admin-sign-in__form">{{ content }}</div>
      {% set tabs_markup = tabs|render %}
      {% if tabs_markup|trim %}
        <div class="uikit-admin-sign-in__tabs">{{ tabs_markup }}</div>
      {% endif %}
    </div>
  </main>
</div>
