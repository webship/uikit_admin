<div{{ attributes.addClass('uikit-admin-topbar') }}>
  <button type="button" class="uikit-admin-topbar__rail-toggle" data-uikit-admin-rail-open aria-label="{{ 'Show the sidebar'|t }}">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div class="uikit-admin-topbar__place">
    {{ breadcrumb }}
    <div class="uikit-admin-topbar__title">{{ title }}</div>
  </div>
  <button type="button" class="uikit-admin-topbar__search" data-uikit-admin-palette-open>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
    <span>{{ search_label|default('Jump to anything'|t) }}</span>
    <kbd>⌘K</kbd>
  </button>
  <div class="uikit-admin-topbar__actions">{{ actions }}</div>
</div>
