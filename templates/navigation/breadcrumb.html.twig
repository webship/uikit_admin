{#
/**
 * @file
 * The breadcrumb, rendered by the breadcrumb component.
 *
 * Core names the label "text"; the component reads "title".
 */
#}
{% if breadcrumb %}
  {% set items = [] %}
  {% for item in breadcrumb %}
    {% set items = items|merge([{ 'title': item.text, 'url': item.url }]) %}
  {% endfor %}
  {{ include('uikit_admin:breadcrumb', { items: items }, with_context: false) }}
{% endif %}
