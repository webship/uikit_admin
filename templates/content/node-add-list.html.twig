{#
/**
 * @file
 * The content types to add, as a grid of card components.
 *
 * The whole card follows its link.
 */
#}
{% if types is not empty %}
  {% set cards = [] %}
  {% for type in types %}
    {% set description %}
      {% if type.description['#markup'] is not empty %}
        <div class="uk-text-meta">{{ type.description }}</div>
      {% endif %}
    {% endset %}
    {% set cards = cards|merge([{
      '#type': 'component',
      '#component': 'uikit_admin:card',
      '#props': {
        heading_level: 2,
        size: 'small',
        attributes: create_attribute({ class: ['uikit-admin-type-tile'] }),
      },
      '#slots': {
        title: { '#markup': type.add_link },
        content: { '#markup': description },
      },
    }]) %}
  {% endfor %}
  {{ include('uikit_admin:grid', {
    attributes: create_attribute({ class: ['uikit-admin-type-list'] }),
    child_width_s: '1-2',
    child_width_l: '1-3',
    gap: 'small',
    items: cards,
  }, with_context: false) }}
{% else %}
  <p>
    {% set create_content = path('node.type_add') %}
    {% trans %}
      You have not created any content types yet. Go to the <a href="{{ create_content }}">content type creation page</a> to add a new content type.
    {% endtrans %}
  </p>
{% endif %}
