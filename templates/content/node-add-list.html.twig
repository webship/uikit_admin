{#
/**
 * @file
 * The content types to add, as a grid of UIkit cards.
 *
 * The whole card follows its link.
 */
#}
{% if types is not empty %}
  <ul class="uk-grid uk-grid-small uk-child-width-1-2@s uk-child-width-1-3@l uikit-admin-type-list" uk-grid="masonry: false">
    {% for type in types %}
      <li>
        <div class="uk-card uk-card-default uk-card-small uk-card-body uikit-admin-type-tile">
          <h2 class="uk-card-title uikit-admin-type-tile__title">{{ type.add_link }}</h2>
          {% if type.description['#markup'] is not empty %}
            <div class="uk-text-meta">{{ type.description }}</div>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p>
    {% set create_content = path('node.type_add') %}
    {% trans %}
      You have not created any content types yet. Go to the <a href="{{ create_content }}">content type creation page</a> to add a new content type.
    {% endtrans %}
  </p>
{% endif %}
