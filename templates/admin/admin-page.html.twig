{#
/**
 * @file
 * The administration index: the panels of every container in one UIkit grid.
 */
#}
{{ system_compact_link }}
<div class="uk-grid uk-grid-small uk-child-width-1-2@m uk-child-width-1-3@l uikit-admin-index" uk-grid>
  {% for container in containers %}
    {% for block in container.blocks %}
      <div>{{ block }}</div>
    {% endfor %}
  {% endfor %}
</div>
