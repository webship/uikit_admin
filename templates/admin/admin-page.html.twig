{#
/**
 * @file
 * The administration index: the panels of every container, rendered by the
 * grid component.
 */
#}
{% set panels = [] %}
{% for container in containers %}
  {% for block in container.blocks %}
    {% set panels = panels|merge([block]) %}
  {% endfor %}
{% endfor %}
{{ system_compact_link }}
{{ include('uikit_admin:grid', {
  attributes: create_attribute({ class: ['uikit-admin-index'] }),
  child_width_m: '1-2',
  child_width_l: '1-3',
  gap: 'small',
  items: panels,
}, with_context: false) }}
