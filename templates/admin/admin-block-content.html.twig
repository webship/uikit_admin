{#
/**
 * @file
 * The tasks of an administration panel, rendered by the admin_task_list
 * component.
 */
#}
{% if content %}
  {% set tasks = [] %}
  {% for item in content %}
    {% set tasks = tasks|merge([{
      'url': item.url,
      'title': item.title,
      'description': item.description,
    }]) %}
  {% endfor %}
  {{ include('uikit_admin:admin_task_list', { attributes: attributes, tasks: tasks }, with_context: false) }}
{% endif %}
