{#
/**
 * @file
 * The status messages, one UIkit alert per type.
 *
 * The wrapper is where Drupal.Message adds the messages of the scripts.
 *
 * @see assets/js/messages.js
 */
#}
<div data-drupal-messages>
{% set variants = { 'status': 'success', 'warning': 'warning', 'error': 'danger', 'info': 'primary' } %}
{% for type, messages in message_list %}
  {% set body %}
    {% if status_headings[type] %}
      <div class="uk-hidden-visually">{{ status_headings[type] }}</div>
    {% endif %}
    {% if messages|length > 1 %}
      <ul class="uk-list uk-margin-remove-bottom">
        {% for message in messages %}<li>{{ message }}</li>{% endfor %}
      </ul>
    {% else %}
      {{ messages|first }}
    {% endif %}
  {% endset %}
  {{ include('uikit_admin:alert', {
    variant: variants[type]|default('primary'),
    close: true,
    role: type == 'error' ? 'alert' : 'status',
    message: body,
  }, with_context: false) }}
{% endfor %}
</div>
