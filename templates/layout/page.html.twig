{#
/**
 * @file
 * The administration page: the rail, the bar and the page.
 *
 * @see \Drupal\uikit_admin\Hook\PreprocessHooks::preprocessPage()
 */
#}
{{ include('uikit_admin:admin_sidebar', {
  site_name: site_name|default('Drupal'),
  site_slogan: site_slogan|default(''),
  sections: rail_sections ?? [],
  account: rail_account ?? {},
}, with_context: false) }}

<div class="uikit-admin-shell">
  {% set topbar %}
    {{ include('uikit_admin:admin_topbar', {
      breadcrumb: page.breadcrumb,
      title: page.header,
      actions: page.highlighted,
    }, with_context: false) }}
  {% endset %}

  {{ include('uikit_admin:admin_page', {
    navbar: topbar,
    offcanvas: page.offcanvas,
    tabs: page.pre_content,
    help: page.help,
    content: page.content,
    sidebar: page.sidebar_first,
    footer: page.footer,
  }, with_context: false) }}
</div>

{{ include('uikit_admin:command_palette', { items: palette_items ?? [] }, with_context: false) }}
