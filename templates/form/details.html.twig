{#
/**
 * @file
 * A details element as a UIkit card with a summary.
 */
#}
<details{{ attributes.addClass(['uk-card', 'uk-card-default', 'uk-card-small', 'uk-card-body', 'uk-margin', 'uikit-admin-details']) }}>
  {% if title %}
    <summary class="uk-card-title uk-h5 uikit-admin-details__summary">{{ title }}</summary>
  {% endif %}
  {% if errors %}
    {{ include('uikit_admin:alert', { variant: 'danger', role: 'alert', content: errors }, with_context: false) }}
  {% endif %}
  {% if description %}<div class="uk-text-meta">{{ description }}</div>{% endif %}
  {{ children }}
  {{ value }}
</details>
