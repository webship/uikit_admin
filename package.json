{
  "name": "uikit_admin",
  "version": "1.0.0",
  "private": true,
  "description": "The administration theme built with UIkit, where every part of the administration screens is a single directory component.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">= 24.0",
    "yarn": ">= 4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:a11y": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js --tags @a11y",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "build:uikit": "node scripts/build-uikit.js"
  },
  "dependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "less": "^4.4.0",
    "uikit": "3.25.22"
  }
}
